// ---------------------------------------------------------------------------
// Merklane — Prisma schema (SQLite, local preview). AUTO-GENERATED — do not edit.
// Regenerate with: bun scripts/sync-sqlite-schema.ts
// ---------------------------------------------------------------------------
// Portable modelling rules applied so the same model definitions also compile
// for the local SQLite preview:
//   * no Prisma enums (SQLite does not support them) — validated in app layer
//   * no scalar lists    (stored as normalised comma-separated strings)
//   * no @db.* type annotations
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  /// bcrypt hash — null until the user sets a password (OAuth-only users)
  passwordHash  String?
  image         String?
  /// "user" | "admin" — server-side authorisation only, never client supplied
  role          String    @default("user")
  /// "free" | "premium" — premium unlocks job-alert dispatch (bots worker)
  plan          String    @default("free")
  /// While set in the future the premium plan is active (null = never expires)
  premiumUntil  DateTime?
  /// User-facing biography shown on the public profile
  bio           String?
  /// Comma separated public links (validated URLs)
  links         String?
  /// Shareable referral code (?ref=CODE on the auth page) — null only on
  /// legacy rows created before the referral launch (backfilled lazily on
  /// first read, see src/lib/referral.ts)
  referralCode  String?   @unique
  /// Who referred this user (set once at registration, never mutated).
  /// Self-referral is impossible: the code owner already exists when the
  /// referred account is created, and referredBy is write-once.
  referredById  String?
  /// Referral commission balance in US cents — 50% of every confirmed
  /// top-up made by referred users. Withdrawn via BlockBee payouts.
  referralBalance Int     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  comments       Comment[]
  reactions      Reaction[]
  bookmarks      Bookmark[]
  telegramLink   TelegramLink?
  adCampaigns    AdCampaign[]
  adTopUps       CryptoTopUp[]
  referredBy     User?                @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      User[]               @relation("UserReferrals")
  withdrawals    ReferralWithdrawal[]

  @@index([email])
  @@index([plan])
}

/// Linked OAuth identities (Google / GitHub). One user may own several.
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "google" | "github"
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Opaque server-side sessions. Only the SHA-256 hash of the cookie token is
/// stored, so a database leak cannot be replayed as a valid session.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use, hashed, expiring tokens: email verification, magic links and
/// password resets share this table, discriminated by `type`.
model VerificationToken {
  id         String    @id @default(cuid())
  identifier String // email address the token was issued to
  tokenHash  String    @unique
  type       String // "email_verify" | "magic_link" | "password_reset"
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, type])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Post {
  id           String    @id @default(cuid())
  slug         String    @unique
  /// "intern-junior" | "mid-senior" | "opportunities" | "markets" | "insights" | "blog"
  section      String
  /// Card label: Job / Internship / Testnet / Quest / Analysis / News / …
  kind         String?
  title        String
  company      String?
  location     String?
  /// Remote / Hybrid / On-site
  workplace    String?
  /// Full-time / Part-time / Internship / …
  employment   String?
  /// Junior / Mid / Senior / Lead / …
  level        String?
  /// Human readable salary range — null means "not provided", never zero
  salary       String?
  /// Specialisation summary, e.g. "Rust / Solana"
  stack        String?
  /// Full markdown-lite body (sanitised on render)
  body         String
  applyUrl     String?
  originalUrl  String?
  /// Normalised comma separated hashtags, e.g. "crypto,trading,junior"
  tags         String    @default("")
  /// "draft" | "published" | "archived" | "deleted"
  status       String    @default("draft")
  authorId     String?
  sourceLocale String    @default("en")
  /// Who/what created the post: "web" | "telegram" | "worker-feed"
  /// (legacy rows may still carry "discord" from before the channel was dropped)
  source       String    @default("web")
  /// External reference for ingestion dedupe (feed id / URL) — null for human posts
  sourceRef    String?
  /// Set once premium notifications have been dispatched for this post
  notifiedAt   DateTime?
  /// Machine-translation cache (LibreTranslate): { ru: { title, body }, es: { … } }.
  /// Filled lazily on localized pages — never blocks rendering (English fallback).
  translations Json?
  publishedAt  DateTime?
  views        Int       @default(0)
  likeCount    Int       @default(0)
  dislikeCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author           User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reactions        Reaction[]
  bookmarks        Bookmark[]
  comments         Comment[]
  reports          Report[]
  notificationLogs NotificationLog[]

  @@index([section, status, publishedAt])
  @@index([status, publishedAt])
  @@index([status, notifiedAt])
  @@index([source, sourceRef])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  /// "like" | "dislike" — one active reaction per user per post
  value     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/// Moderation queue. Reporters never need an account; reporter identity is
/// never published next to the post.
model Report {
  id        String   @id @default(cuid())
  postId    String
  reason    String
  details   String?
  contact   String?
  /// "open" | "in_review" | "resolved" | "dismissed"
  status    String   @default("open")
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Growth
// ---------------------------------------------------------------------------

/// Merklane Ads launch waitlist (/ads "Coming soon" capture).
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Where the signup happened: "ads" | "premium" | …
  source    String   @default("ads")
  createdAt DateTime @default(now())
}

/// Contact / report messages sent from the public contact page.
model ContactMessage {
  id        String   @id @default(cuid())
  email     String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Bots & background workers (job ingestion + premium job alerts)
// ---------------------------------------------------------------------------

/// Links a web account to a Telegram chat so the premium-alerts worker can DM
/// new job postings. The one-time deep-link token is stored hashed only.
model TelegramLink {
  id        String    @id @default(cuid())
  userId    String    @unique
  chatId    String?   @unique
  username  String?
  /// SHA-256 hash of the one-time /start deep-link token
  linkTokenHash String @unique
  notificationsEnabled Boolean @default(true)
  linkedAt  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Admin intake bot state machine — one wizard draft per admin Telegram user,
/// driving the step-by-step job composer (inline buttons) behind
/// /api/webhooks/telegram-admin (TELEGRAM_ADMIN_BOT_TOKEN).
model TelegramAdminState {
  id          String   @id @default(cuid())
  /// Telegram user id (must be listed in TELEGRAM_ADMIN_USER_IDS)
  adminUserId String   @unique
  /// Current flow step: 'paste' (awaiting the pasted raw job text) or
  /// 'confirm' (parsed draft shown — awaiting ✅ Publish / 📝 Draft / 🔄 Section)
  step        String
  /// Parsed job fields (JobIntakeSpec-compatible JSON) + parser guesses
  draft       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Per-post × per-channel delivery ledger. The unique triple
/// (postId, channel, recipient) makes dispatch idempotent — a recipient never
/// receives the same posting twice, even across worker restarts.
model NotificationLog {
  id        String    @id @default(cuid())
  postId    String
  /// "email" | "telegram" (legacy "discord" rows age out via retries)
  channel   String
  /// Email address or Telegram chat id
  recipient String
  userId    String?
  /// "pending" | "sent" | "failed" | "skipped"
  status    String    @default("pending")
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, channel, recipient])
  @@index([status, createdAt])
  @@index([postId])
  @@index([userId])
}

/// Audit trail for every bot/worker write (job created, command rejected,
/// feed fetched, premium granted, …) — used for observability and rate audits.
model IngestionLog {
  id        String   @id @default(cuid())
  /// "telegram" | "worker-feed" | "web" | "worker-stats"
  /// (legacy rows may still carry "discord" from before the channel was dropped)
  source    String
  action    String
  ok        Boolean  @default(true)
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@index([ok, createdAt])
}

// ---------------------------------------------------------------------------
// About-page statistics (anonymous visitor measurement + daily snapshots)
// ---------------------------------------------------------------------------

/// One row per deduplicated page view, written by the /api/track beacon.
/// PRIVACY: no raw IP, no user agent and no user id are ever stored —
/// `visitorId` is HMAC-SHA256(ip + user-agent) (stable per visitor, not
/// reversible) and `country` is a 2-letter ISO code taken from proxy headers
/// only (CF-IPCountry / x-vercel-ip-country). "XX" means unknown.
model Visit {
  id        String   @id @default(cuid())
  /// First-party page path, e.g. "/mid-senior/some-slug"
  path      String
  /// Content section slug, or "home" | "about" | "search" | "premium" | "auth" | "profile" | "other"
  section   String
  /// ISO 3166-1 alpha-2 country code from proxy headers ("XX" = unknown)
  country   String   @default("XX")
  /// HMAC-SHA256(ip + user-agent) — dedupe + unique-visitor counting
  visitorId String
  createdAt DateTime @default(now())

  @@index([visitorId, createdAt])
  @@index([section, createdAt])
  @@index([country, createdAt])
}

/// One snapshot of the public About-page statistics per UTC day. Computed by
/// the worker once per day (STATS_SNAPSHOT_UTC_HOUR, with backfill for missed
/// days) or on demand by an admin via POST /api/admin/stats. The JSON shape is
/// versioned (see StatsSnapshot in src/lib/stats/types.ts) and stores raw
/// numbers only — all labels/formatting live in the UI so a future i18n layer
/// only needs to translate labels, never data.
model DailyStats {
  id        String   @id @default(cuid())
  /// UTC midnight of the day this snapshot describes
  date      DateTime @unique
  /// Versioned StatsSnapshot JSON (raw numbers, no localized strings)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ---------------------------------------------------------------------------
// Site CMS (Telegram-admin-bot-managed content: logo, team avatars & bios)
// ---------------------------------------------------------------------------

/**
 * Key-value store for operator-managed site content, written through the
 * Telegram admin bot (Manage Team / Change Logo flows). Values are plain
 * strings; uploaded images are stored as data URLs (base64) so they survive
 * container recreation without baking files into the Docker image.
 *
 * Keys in use (see src/lib/site-settings.ts — the typed accessor):
 *   current_logo_url      site logo shown on /about (data URL)
 *   team_<member>_avatar  uploaded avatar for team member <member>
 *   team_<member>_bio     bio text for team member <member>
 * where <member> ∈ { vazima, trinity, grobofhik }.
 */
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Merklane Ads — campaigns, weighted auction, impressions, crypto top-ups
// ---------------------------------------------------------------------------

/**
 * One advertiser campaign. Money is stored in US CENTS (Int) so the same
 * definition works on PostgreSQL and the SQLite preview without Decimal
 * columns: balance = remaining budget, bidPerView = price (and auction
 * weight) per SERVED impression.
 *
 * status: "active" (eligible for the auction) | "paused" (advertiser pause
 * OR balance drained to 0 — resume after a top-up) | "ended" (operator stop).
 */
model AdCampaign {
  id           String   @id @default(cuid())
  advertiserId String
  /// Card headline (plain text, ≤ 80 chars)
  title        String
  /// Card body copy (plain text, ≤ 200 chars)
  body         String
  /// Destination URL opened on click (https only)
  ctaUrl       String
  /// Optional button label override (default from the i18n dictionary)
  ctaLabel     String?
  /// Remaining budget in US cents; every served impression decrements this
  balance      Int      @default(0)
  /// Price per served impression in US cents — doubles as the auction weight
  bidPerView   Int      @default(1)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  advertiser  User            @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  impressions AdImpression[]
  topUps      CryptoTopUp[]

  @@index([status, balance])
  @@index([advertiserId, createdAt])
}

/**
 * Ledger row per billed event. type: "view" (ad served into a slot — the
 * billable event that decrements the campaign balance) | "click" (the
 * visitor followed the call-to-action — never billed twice for the same
 * impression).
 */
model AdImpression {
  id         String   @id @default(cuid())
  campaignId String
  type       String
  createdAt  DateTime @default(now())

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, type, createdAt])
  @@index([createdAt])
}

/**
 * One crypto deposit intention. `walletAddress` is the address the customer
 * pays to: issued by BlockBee (provider="blockbee", paid via the IPN webhook
 * at /api/webhooks/blockbee) or derived from the mock HD wallet in the
 * manual/simulate fallback modes (provider="manual", confirmed by an admin
 * or — demos only — the advertiser themselves).
 *
 * status: "pending" | "confirmed" | "expired".
 */
model CryptoTopUp {
  id             String    @id @default(cuid())
  advertiserId   String
  /// Target campaign for the credit (null → advertiser's newest campaign)
  campaignId     String?
  walletAddress  String
  /// Expected amount in US cents
  amountExpected Int
  /// Confirmed received amount in US cents (0 until confirmed)
  amountReceived Int       @default(0)
  status         String    @default("pending")
  /// "blockbee" | "manual" — which provider issued the deposit address
  provider       String    @default("manual")
  /// BlockBee coin ticker for this intention (e.g. polygon_usdt) — manual mode: null
  coin           String?
  /// Unguessable per-intention nonce embedded in the BlockBee callback URL
  /// and verified on every IPN (binds a webhook to exactly this intention)
  callbackNonce  String?
  /// BlockBee payment UUID — the cross-retry dedupe key echoed by every IPN
  uuid           String?   @unique
  /// On-chain transaction hash of the incoming payment (txid_in)
  txHash         String?
  /// Crypto amount paid, as received (string — never trust floats with money)
  paidCoinAmount String?
  /// Coin USD price at payment time (BlockBee `price` field), string
  coinPriceUsd   String?
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?

  advertiser User        @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaign   AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([advertiserId, status])
  @@index([status, createdAt])
  @@index([provider, status])
}

/**
 * Append-only audit trail for every payment event: BlockBee IPNs (accepted
 * AND rejected), payout webhook transitions, admin/simulate confirms,
 * referral commissions and withdrawal requests. `externalId` carries the
 * BlockBee payment uuid / payout id / on-chain tx hash so an operator can
 * cross-reference any ledger movement with the processor's console.
 */
model PaymentLog {
  id          String   @id @default(cuid())
  /// "blockbee_ipn" | "blockbee_payout" | "admin_confirm" |
  /// "simulate_confirm" | "referral_withdraw" | "referral_commission"
  source      String
  /// What happened: "received" | "rejected" | "credited" | "pending" |
  /// "done" | "failed" | "commission_credited" | …
  event       String
  ok          Boolean  @default(true)
  /// BlockBee payment uuid / payout id / tx hash
  externalId  String?
  /// CryptoTopUp.id or ReferralWithdrawal.id this event belongs to
  referenceId String?
  userId      String?
  amountCents Int?
  /// Sanitised payload snapshot (no secrets, truncated)
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([source, createdAt])
  @@index([referenceId])
  @@index([externalId])
}

/**
 * One referral-commission withdrawal. The user requests a payout of part of
 * their referralBalance; the funds are sent through the BlockBee payout
 * chain (request → create → process) to the user's own crypto address.
 *
 * IMPORTANT: referralBalance is deducted only when BlockBee confirms the
 * payout (status "done" via the payout webhook) — a failed/expired payout
 * never takes the user's balance. While a withdrawal is pending/processing
 * the user cannot start a second one (single-active-withdrawal guard).
 *
 * status: "pending" (row created, BlockBee chain not yet complete) |
 * "processing" (broadcast accepted, awaiting on-chain settlement) |
 * "done" (confirmed on-chain — balance deducted) | "failed" (chain/API
 * error, nothing was sent) | "expired" (settlement dropped, nothing was
 * sent) | "underfunded" (payout settled but the balance changed underneath
 * — operator must resolve manually; should never happen).
 */
model ReferralWithdrawal {
  id              String    @id @default(cuid())
  userId          String
  /// Requested amount in US cents (what is deducted from referralBalance)
  amountCents     Int
  /// BlockBee ticker the payout is sent in (e.g. polygon_usdt)
  coin            String
  /// Destination address provided by the user
  address         String
  /// Crypto amount sent (converted from USD at request time, string)
  coinAmount      String?
  /// BlockBee payout REQUEST id (payout/request/create)
  payoutRequestId String?
  /// BlockBee payout id (payout/create) — the processable id echoed by the
  /// payout webhook
  payoutId        String?   @unique
  status          String    @default("pending")
  error           String?
  txHash          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}
