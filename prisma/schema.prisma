// ---------------------------------------------------------------------------
// Merklane — Prisma schema (PostgreSQL, production)
// ---------------------------------------------------------------------------
// Portable modelling rules applied so the same model definitions also compile
// for the local SQLite preview:
//   * no Prisma enums (SQLite does not support them) — validated in app layer
//   * no scalar lists    (stored as normalised comma-separated strings)
//   * no @db.* type annotations
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  /// bcrypt hash — null until the user sets a password (OAuth-only users)
  passwordHash  String?
  image         String?
  /// "user" | "admin" — server-side authorisation only, never client supplied
  role          String    @default("user")
  /// "free" | "premium" — premium unlocks job-alert dispatch (bots worker)
  plan          String    @default("free")
  /// While set in the future the premium plan is active (null = never expires)
  premiumUntil  DateTime?
  /// User-facing biography shown on the public profile
  bio           String?
  /// Comma separated public links (validated URLs)
  links         String?
  /// Shareable referral code (?ref=CODE on the auth page) — null only on
  /// legacy rows created before the referral launch (backfilled lazily on
  /// first read, see src/lib/referral.ts)
  referralCode  String?   @unique
  /// Who referred this user (set once at registration, never mutated).
  /// Self-referral is impossible: the code owner already exists when the
  /// referred account is created, and referredBy is write-once.
  referredById  String?
  /// Referral commission balance in US cents — 50% of every confirmed
  /// top-up made by referred users. Withdrawn via BlockBee payouts.
  referralBalance Int     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  comments       Comment[]
  reactions      Reaction[]
  bookmarks      Bookmark[]
  telegramLink   TelegramLink?
  /// Phase-1 ads architecture: one advertiser wallet per user (micro-USD
  /// double-entry ledger, see Wallet/LedgerEntry below).
  wallet         Wallet?
  campaigns      Campaign[]
  adTopUps       CryptoTopUp[]
  premiumOrders  PremiumOrder[]
  referredBy     User?                @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      User[]               @relation("UserReferrals")
  withdrawals    ReferralWithdrawal[]

  @@index([email])
  @@index([plan])
}

/// Linked OAuth identities (Google / GitHub). One user may own several.
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "google" | "github"
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Opaque server-side sessions. Only the SHA-256 hash of the cookie token is
/// stored, so a database leak cannot be replayed as a valid session.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use, hashed, expiring tokens: email verification, magic links and
/// password resets share this table, discriminated by `type`.
model VerificationToken {
  id         String    @id @default(cuid())
  identifier String // email address the token was issued to
  tokenHash  String    @unique
  type       String // "email_verify" | "magic_link" | "password_reset"
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, type])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Post {
  id           String    @id @default(cuid())
  slug         String    @unique
  /// "intern-junior" | "mid-senior" | "opportunities" | "markets" | "insights" | "blog"
  section      String
  /// Card label: Job / Internship / Testnet / Quest / Analysis / News / …
  kind         String?
  title        String
  company      String?
  location     String?
  /// Remote / Hybrid / On-site
  workplace    String?
  /// Full-time / Part-time / Internship / …
  employment   String?
  /// Junior / Mid / Senior / Lead / …
  level        String?
  /// Human readable salary range — null means "not provided", never zero
  salary       String?
  /// Specialisation summary, e.g. "Rust / Solana"
  stack        String?
  /// Full markdown-lite body (sanitised on render)
  body         String
  applyUrl     String?
  originalUrl  String?
  /// Normalised comma separated hashtags, e.g. "crypto,trading,junior"
  tags         String    @default("")
  /// "draft" | "published" | "archived" | "deleted"
  status       String    @default("draft")
  authorId     String?
  sourceLocale String    @default("en")
  /// Who/what created the post: "web" | "telegram" | "worker-feed"
  /// (legacy rows may still carry "discord" from before the channel was dropped)
  source       String    @default("web")
  /// External reference for ingestion dedupe (feed id / URL) — null for human posts
  sourceRef    String?
  /// Set once premium notifications have been dispatched for this post
  notifiedAt   DateTime?
  /// Machine-translation cache (LibreTranslate): { ru: { title, body }, es: { … } }.
  /// Filled lazily on localized pages — never blocks rendering (English fallback).
  translations Json?
  publishedAt  DateTime?
  views        Int       @default(0)
  likeCount    Int       @default(0)
  dislikeCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author           User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reactions        Reaction[]
  bookmarks        Bookmark[]
  comments         Comment[]
  reports          Report[]
  notificationLogs NotificationLog[]

  @@index([section, status, publishedAt])
  @@index([status, publishedAt])
  @@index([status, notifiedAt])
  @@index([source, sourceRef])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  /// "like" | "dislike" — one active reaction per user per post
  value     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/// Moderation queue. Reporters never need an account; reporter identity is
/// never published next to the post.
model Report {
  id        String   @id @default(cuid())
  postId    String
  reason    String
  details   String?
  contact   String?
  /// "open" | "in_review" | "resolved" | "dismissed"
  status    String   @default("open")
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Growth
// ---------------------------------------------------------------------------

/// Merklane Ads launch waitlist (/ads "Coming soon" capture).
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Where the signup happened: "ads" | "premium" | …
  source    String   @default("ads")
  createdAt DateTime @default(now())
}

/// Contact / report messages sent from the public contact page.
model ContactMessage {
  id        String   @id @default(cuid())
  email     String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Bots & background workers (job ingestion + premium job alerts)
// ---------------------------------------------------------------------------

/// Links a web account to a Telegram chat so the premium-alerts worker can DM
/// new job postings. The one-time deep-link token is stored hashed only.
model TelegramLink {
  id        String    @id @default(cuid())
  userId    String    @unique
  chatId    String?   @unique
  username  String?
  /// SHA-256 hash of the one-time /start deep-link token
  linkTokenHash String @unique
  notificationsEnabled Boolean @default(true)
  linkedAt  DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Admin intake bot state machine — one wizard draft per admin Telegram user,
/// driving the step-by-step job composer (inline buttons) behind
/// /api/webhooks/telegram-admin (TELEGRAM_ADMIN_BOT_TOKEN).
model TelegramAdminState {
  id          String   @id @default(cuid())
  /// Telegram user id (must be listed in TELEGRAM_ADMIN_USER_IDS)
  adminUserId String   @unique
  /// Current flow step: 'paste' (awaiting the pasted raw job text) or
  /// 'confirm' (parsed draft shown — awaiting ✅ Publish / 📝 Draft / 🔄 Section)
  step        String
  /// Parsed job fields (JobIntakeSpec-compatible JSON) + parser guesses
  draft       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Per-post × per-channel delivery ledger. The unique triple
/// (postId, channel, recipient) makes dispatch idempotent — a recipient never
/// receives the same posting twice, even across worker restarts.
model NotificationLog {
  id        String    @id @default(cuid())
  postId    String
  /// "email" | "telegram" (legacy "discord" rows age out via retries)
  channel   String
  /// Email address or Telegram chat id
  recipient String
  userId    String?
  /// "pending" | "sent" | "failed" | "skipped"
  status    String    @default("pending")
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, channel, recipient])
  @@index([status, createdAt])
  @@index([postId])
  @@index([userId])
}

/// Audit trail for every bot/worker write (job created, command rejected,
/// feed fetched, premium granted, …) — used for observability and rate audits.
model IngestionLog {
  id        String   @id @default(cuid())
  /// "telegram" | "worker-feed" | "web" | "worker-stats"
  /// (legacy rows may still carry "discord" from before the channel was dropped)
  source    String
  action    String
  ok        Boolean  @default(true)
  detail    String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@index([ok, createdAt])
}

// ---------------------------------------------------------------------------
// About-page statistics (anonymous visitor measurement + daily snapshots)
// ---------------------------------------------------------------------------

/// One row per deduplicated page view, written by the /api/track beacon.
/// PRIVACY: no raw IP, no user agent and no user id are ever stored —
/// `visitorId` is HMAC-SHA256(ip + user-agent) (stable per visitor, not
/// reversible) and `country` is a 2-letter ISO code taken from proxy headers
/// only (CF-IPCountry / x-vercel-ip-country). "XX" means unknown.
model Visit {
  id        String   @id @default(cuid())
  /// First-party page path, e.g. "/mid-senior/some-slug"
  path      String
  /// Content section slug, or "home" | "about" | "search" | "premium" | "auth" | "profile" | "other"
  section   String
  /// ISO 3166-1 alpha-2 country code from proxy headers ("XX" = unknown)
  country   String   @default("XX")
  /// HMAC-SHA256(ip + user-agent) — dedupe + unique-visitor counting
  visitorId String
  createdAt DateTime @default(now())

  @@index([visitorId, createdAt])
  @@index([section, createdAt])
  @@index([country, createdAt])
}

/// One snapshot of the public About-page statistics per UTC day. Computed by
/// the worker once per day (STATS_SNAPSHOT_UTC_HOUR, with backfill for missed
/// days) or on demand by an admin via POST /api/admin/stats. The JSON shape is
/// versioned (see StatsSnapshot in src/lib/stats/types.ts) and stores raw
/// numbers only — all labels/formatting live in the UI so a future i18n layer
/// only needs to translate labels, never data.
model DailyStats {
  id        String   @id @default(cuid())
  /// UTC midnight of the day this snapshot describes
  date      DateTime @unique
  /// Versioned StatsSnapshot JSON (raw numbers, no localized strings)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ---------------------------------------------------------------------------
// Site CMS (Telegram-admin-bot-managed content: logo, team members)
// ---------------------------------------------------------------------------

/**
 * Key-value store for operator-managed site content, written through the
 * Telegram admin bot (Change Logo flow). Values are plain strings; uploaded
 * images are stored as data URLs (base64) so they survive container
 * recreation without baking files into the Docker image.
 *
 * Keys in use (see src/lib/site-settings.ts — the typed accessor):
 *   current_logo_url   site favicon served by /api/favicon (data URL)
 *
 * Legacy keys (pre team-CMS era, merged into TeamMember rows once by the
 * lazy seed in src/lib/team.ts, kept so existing deployments don't lose
 * operator-uploaded content):
 *   team_<member>_avatar  uploaded avatar (member ∈ vazima/trinity/grobofhik)
 *   team_<member>_bio     bio text
 */
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/**
 * One team member card rendered on /about. Fully dynamic — rows are created,
 * edited and removed through the Telegram admin bot (👥 Manage team →
 * ➕ Add New Member / per-member edit / 🗑 Remove). `order` drives the card
 * order on the page (ascending; ties broken by createdAt).
 */
model TeamMember {
  id        String   @id @default(cuid())
  /// Display name (1–60 chars, enforced by the bot).
  name      String
  /// Role / job title shown under the name (plain text, e.g. "CEO").
  role      String   @default("")
  /// Short bio (≤ 400 chars). Empty → localized placeholder on /about.
  bio       String   @default("")
  /// Photo: data URL (Telegram upload) or public image URL. Null → initials.
  avatarUrl String?
  /// Public profile link; when set the whole card becomes the link.
  socialUrl String?
  /// Sort key (ascending) — new members are appended at the end.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Merklane Ads — Phase 1: double-entry wallet, campaign/creative structure,
// budget reservations, crypto top-ups
// Phase 2: step-by-step wizard, banner uploads, advanced targeting
// (keywords / countries / hashtags), DRAFT → PENDING → APPROVED moderation
// lifecycle driven from the Telegram admin bot
// ---------------------------------------------------------------------------

/**
 * ONE advertiser wallet per user. All money is INTEGER micro-USD
 * ($1.00 = 1_000_000 µUSD) — floats are never used for money anywhere.
 *
 *   availableMicroUsd   spendable balance (top-ups land here)
 *   reservedMicroUsd    money committed to the user's campaigns — the sum of
 *                       each campaign's unspent budget (see Campaign below).
 *
 * Invariant, enforced by the ledger (LedgerEntry) and the conditional
 * updateMany guards in src/lib/ads/wallet.ts:
 *
 *   available + reserved == Σ(CREDIT) − Σ(CHARGE)
 *
 * Wallet rows are created lazily on the first money event (getOrCreateWallet).
 */
model Wallet {
  id                String   @id @default(cuid())
  userId            String   @unique
  availableMicroUsd Int      @default(0)
  reservedMicroUsd  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger LedgerEntry[]
}

/**
 * Append-only money ledger — one row per movement against a wallet, the
 * single source of truth for the ad budget. Rows are NEVER updated or
 * deleted (the application layer exposes no mutation path; the column set
 * has nothing to reconcile).
 *
 * type (validated in the app layer, no Prisma enums for SQLite portability):
 *   credit   +amount  top-up confirmed (BlockBee IPN / admin / simulate)
 *   reserve  −amount  wallet.available → committed to a campaign
 *                     (campaign create / "add funds"; campaignId set)
 *   charge   −amount  money SPENT — a CPC click or CPM view finalised its
 *                     BudgetReservation; leaves the wallet for good
 *                     (campaignId set)
 *   refund   +amount  a deleted campaign's unspent budget released back to
 *                     the wallet (campaignId set)
 *
 * eventId is UNIQUE and deterministic for every exactly-once-critical
 * movement (topup:<id>, charge:<reservationId>, refund:<campaignId>) so
 * processor retries can never double-post. Non-critical movements
 * (fund:<campaignId>:<uuid>) carry a fresh id per call — their amount is
 * guarded by the conditional wallet decrement instead.
 */
model LedgerEntry {
  id             String   @id @default(cuid())
  walletId       String
  type           String
  /// Signed micro-USD: credit/refund positive, reserve/charge negative.
  amountMicroUsd Int
  /// Set for reserve/charge/refund; null on plain top-up credits.
  campaignId     String?
  /// Unique idempotency key (see model comment).
  eventId        String   @unique
  createdAt      DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([campaignId, createdAt])
}

/**
 * One advertiser campaign. A campaign has exactly ONE billing model:
 *
 *   billingModel (app-layer validated, lowercase):
 *     "cpc"  bidMicroUsd is the price of ONE click. Serving holds a
 *            BudgetReservation for one bid; a valid click within 30 minutes
 *            finalises it (charge), otherwise it expires (budget recovers).
 *     "cpm"  bidMicroUsd is the price of 1000 views. One view costs
 *            bidMicroUsd / 1000 (integer — whole-cent bids divide cleanly);
 *            every served view is charged immediately (Phase 1 has no
 *            viewability measurement, so the serve IS the confirmed view).
 *
 *   format: "text" | "banner" — selects the Creative shape (title/body vs
 *   imageUrl) and the rendering in <AdSlot/>.
 *
 *   status (app-layer validated, lowercase):
 *     "draft" | "pending" | "active" | "paused" | "completed" | "rejected"
 *   Only "active" campaigns with deletedAt = null AND an APPROVED latest
 *   creative enter the auction (Phase 2 moderation: campaigns go
 *   DRAFT → PENDING (submit for review) → ACTIVE (approved) or REJECTED;
 *   editing an APPROVED campaign appends a new creative revision and sends
 *   the campaign back to PENDING).
 *
 * Budget semantics — a campaign has no mutable "balance" column. Its
 * spendable budget is always derived from the ledger:
 *
 *   committed = Σ|reserve| − Σrefund      (money moved wallet → campaign)
 *   spent     = Σ|charge|                 (money spent on clicks/views)
 *   held      = Σ held BudgetReservations (in-flight, awaiting click/expiry)
 *   remaining = committed − spent − held
 *
 * totalBudgetMicroUsd records the current total allocation (it grows with
 * "add funds"). For a DRAFT it stores the PLANNED budget — the money is
 * reserved from the wallet only when the campaign is submitted for review
 * (PATCH action "submit"), so drafts never lock wallet funds. dailyBudget-
 * MicroUsd is a per-UTC-day spend cap where 0 = no daily cap. deletedAt is
 * the soft delete: deleted campaigns never serve again and their unspent
 * budget is refunded to the wallet (ledger type refund) at deletion time —
 * the delete action works from EVERY state, drafts included.
 *
 * Targeting (all stored as normalised CSV strings — see the modelling rules
 * at the top of this file; empty = no restriction, the campaign then buys
 * that dimension everywhere):
 *   targetSections   section slugs ("intern-junior", …)
 *   targetLocales    interface locale codes ("en", "ru", …)
 *   targetKeywords   contextual keyword phrases (lowercase). Matching is
 *                    controlled by keywordMatch:
 *                      "phrase" — a keyword matches when it appears as a
 *                                 case-insensitive substring of the page's
 *                                 keyword context (title + tags)
 *                      "exact"  — a keyword must equal one of the page's
 *                                 context phrases exactly
 *   countryMode      visitor-country filter:
 *                      "all"      — no country restriction (default)
 *                      "include"  — serve ONLY in the listed countries
 *                      "exclude"  — serve everywhere EXCEPT the listed ones
 *   targetCountries  ISO 3166-1 alpha-2 codes, uppercase ("DE,US")
 *   targetHashtags   exact hashtags (lowercase, no "#") matched against the
 *                    tags of the page being served
 * A campaign with a restriction in a dimension never buys UNKNOWN inventory:
 * pages that carry no keyword/hashtag/country context only match campaigns
 * without that restriction (src/lib/ads/targeting.ts).
 */
model Campaign {
  id                  String    @id @default(cuid())
  advertiserId        String
  /// Internal/administrative name shown in the dashboard (1–80 chars).
  name                String
  /// "text" | "banner"
  format              String    @default("text")
  /// "cpc" | "cpm" — exactly one per campaign
  billingModel        String    @default("cpc")
  /// CPC: price of one click. CPM: price of 1000 views. Integer micro-USD.
  bidMicroUsd         Int
  /// Per-UTC-day spend cap. 0 = no daily cap.
  dailyBudgetMicroUsd Int       @default(0)
  /// Current total allocation reserved from the wallet at create/fund time.
  /// For drafts: the PLANNED budget (reserved at submit-for-review time).
  totalBudgetMicroUsd Int
  /// "draft" | "pending" | "active" | "paused" | "completed" | "rejected"
  status              String    @default("draft")
  /// Soft delete — set together with status "completed"; the unspent
  /// budget is refunded to the wallet in the same transaction.
  deletedAt           DateTime?
  /// Comma-separated target section slugs; empty = every section.
  targetSections      String    @default("")
  /// Comma-separated target locale codes; empty = every language.
  targetLocales       String    @default("")
  /// Comma-separated lowercase keyword phrases; empty = site-wide.
  targetKeywords      String    @default("")
  /// "phrase" | "exact" — how targetKeywords is matched (see model comment).
  keywordMatch        String    @default("phrase")
  /// "all" | "include" | "exclude" — visitor-country filter mode.
  countryMode         String    @default("all")
  /// Comma-separated ISO 3166-1 alpha-2 codes (uppercase); empty = all.
  targetCountries     String    @default("")
  /// Comma-separated lowercase hashtags (no "#"); empty = no restriction.
  targetHashtags      String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  advertiser   User                @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  creatives    Creative[]
  reservations BudgetReservation[]
  adEvents     AdEvent[]

  @@index([status, deletedAt])
  @@index([advertiserId, createdAt])
}

/**
 * The ad content of a campaign. Versioned: every content edit appends a NEW
 * row (version = previous + 1) — creative history is append-only, the
 * auction always serves the latest APPROVED version.
 *
 *   format "text"   → title + body are the card copy (imageUrl stays null)
 *   format "banner" → imageUrl is the creative (title/body stay null) — a
 *                     LOCAL upload path ("/uploads/ads/<uuid>.png") produced
 *                     by /api/ads/assets/upload (Phase 2: no external URLs)
 *
 * targetUrl is the https destination every click opens. displayDomain is
 * the optional friendly host shown on the card (defaults to the target
 * URL's host). altText is the banner accessibility label.
 *
 * moderationStatus (app-layer validated): "draft" | "pending" | "approved" |
 * "rejected" — the Phase 2 lifecycle: a draft creative is born "draft",
 * "submit for review" flips it to "pending", a moderator (Telegram admin
 * bot) approves or rejects it; a rejection stores the human reason in
 * moderationNote so the dashboard can show exactly what to fix. Campaigns
 * only serve their latest creative while it is APPROVED.
 */
model Creative {
  id        String   @id @default(cuid())
  campaignId String
  /// Text format: card headline (≤ 120 chars). Banner format: null.
  title     String?
  /// Text format: card body copy (≤ 500 chars). Banner format: null.
  body      String?
  /// Banner format: LOCAL upload path (/uploads/ads/…). Text format: null.
  imageUrl  String?
  /// Banner format: accessibility label (≤ 120 chars).
  altText   String?
  /// Optional friendly domain shown on the card instead of the target host.
  displayDomain String?
  /// https destination opened on click (both formats).
  targetUrl String
  /// Monotonic per campaign — 1 on create, +1 per content edit.
  version   Int      @default(1)
  /// "draft" | "pending" | "approved" | "rejected"
  moderationStatus String @default("draft")
  /// Moderator's rejection reason (set when moderationStatus = "rejected").
  moderationNote   String?
  createdAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, version])
}

/**
 * In-flight budget hold for ONE billable event.
 *
 *   Phase 3 event pipeline — SERVING NEVER CHARGES. Both models create the
 *   reservation HELD; the charge happens only when a validated event
 *   finalises it:
 *
 *   CPC:  created HELD for one bid when the ad is served; a valid click
 *         (through the signed /api/ads/click/[token] redirect) within 30
 *         minutes finalises it (charge + ledger entry).
 *   CPM:  created HELD for bid/1000 when the ad is served; a valid
 *         viewable_impression event (≥ 50 % of the ad visible for one
 *         continuous second in an active tab, measured client-side and
 *         verified server-side against the HMAC token) finalises it.
 *
 *   No validating event within the 30-minute TTL → the sweeper
 *   (expireStaleReservations) flips the row to EXPIRED and the held amount
 *   is released back to the campaign's derived budget — the advertiser is
 *   never charged for an unviewable, unclicked serve ("refund on expiry").
 *
 * status: "held" | "finalized" | "expired" (app-layer validated). Rows are
 * immutable once finalised/expired; a duplicate click/event on a FINALIZED
 * row is a no-op (the conditional status flip settles double-fires to a
 * single charge; the unique ledger eventId charge:<reservationId> is the
 * second line of defence).
 */
model BudgetReservation {
  id             String   @id @default(cuid())
  campaignId     String
  /// Micro-USD held for this event: CPC = the full bid; CPM = bid/1000.
  amountMicroUsd Int
  /// "held" | "finalized" | "expired"
  status         String
  /// When an unclicked CPC hold releases the budget back to the campaign.
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([status, expiresAt])
}

/**
 * Phase 3 event pipeline — the delivery log behind the advertiser reports.
 *
 * One row per (reservation, event type). The three types are logged
 * SEPARATELY so the dashboard can report each stage of the funnel:
 *
 *   loaded_impression    the ad was served (logged atomically with the
 *                        BudgetReservation creation — server-side, cannot
 *                        be forged or missed)
 *   viewable_impression  the client confirmed ≥ 50 % of the ad was visible
 *                        for one continuous second in an active tab
 *                        (IntersectionObserver + Page Visibility API in
 *                        <AdSlot/>; verified server-side against the HMAC
 *                        ad token). Billable for CPM, informational for CPC.
 *   valid_click           the visitor clicked through the signed redirect
 *                        route /api/ads/click/[token] while the reservation
 *                        was still in its window. Billable for CPC,
 *                        informational for CPM (CPM bills views, not clicks).
 *
 * @@unique([reservationId, eventType]) is the exactly-once guard: a double
 * click, a replayed beacon or a bot retrying the event can insert the row
 * only once (P2002 → treated as a duplicate, never a second charge — the
 * charge itself is additionally guarded by the reservation's conditional
 * status flip and the unique ledger eventId).
 *
 * ipHash is a salted SHA-256 prefix of the visitor IP (never the raw IP);
 * userAgent is kept truncated for anti-fraud analytics. slot records which
 * placement delivered the event.
 */
model AdEvent {
  id            String   @id @default(cuid())
  campaignId    String
  /// The BudgetReservation this event belongs to (the serve's in-flight hold).
  reservationId String
  /// "loaded_impression" | "viewable_impression" | "valid_click"
  eventType     String
  /// Placement id ("home_banner" | "feed" | "article_bottom").
  slot          String?
  /// Truncated User-Agent of the visitor (anti-fraud analytics).
  userAgent     String?
  /// Salted SHA-256 prefix of the visitor IP — anonymised, never raw.
  ipHash        String?
  createdAt     DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([reservationId, eventType])
  @@index([campaignId, eventType, createdAt])
  @@index([campaignId, createdAt])
}

/**
 * One crypto deposit intention. `walletAddress` is the address the customer
 * pays to: issued by BlockBee (provider="blockbee", paid via the IPN webhook
 * at /api/webhooks/blockbee) or derived from the mock HD wallet in the
 * manual/simulate fallback modes (provider="manual", confirmed by an admin
 * or — demos only — the advertiser themselves).
 *
 * status: "pending" | "confirmed" | "expired".
 */
model CryptoTopUp {
  id             String    @id @default(cuid())
  advertiserId   String
  walletAddress  String
  /// Expected amount in US cents
  amountExpected Int
  /// Confirmed received amount in US cents (0 until confirmed)
  amountReceived Int       @default(0)
  status         String    @default("pending")
  /// "blockbee" | "manual" — which provider issued the deposit address
  provider       String    @default("manual")
  /// BlockBee coin ticker for this intention (e.g. polygon_usdt) — manual mode: null
  coin           String?
  /// Unguessable per-intention nonce embedded in the BlockBee callback URL
  /// and verified on every IPN (binds a webhook to exactly this intention)
  callbackNonce  String?
  /// BlockBee payment UUID — the cross-retry dedupe key echoed by every IPN
  uuid           String?   @unique
  /// On-chain transaction hash of the incoming payment (txid_in)
  txHash         String?
  /// Crypto amount paid, as received (string — never trust floats with money)
  paidCoinAmount String?
  /// Coin USD price at payment time (BlockBee `price` field), string
  coinPriceUsd   String?
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?

  advertiser User @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([advertiserId, status])
  @@index([status, createdAt])
  @@index([provider, status])
}

// ---------------------------------------------------------------------------
// Premium subscriptions (BlockBee billing — Premium & Premium+)
// ---------------------------------------------------------------------------

/**
 * One Premium/Premium+ checkout intention. The row id IS the BlockBee
 * order_id and carries the routing prefix:
 *
 *   prem_<m|y>_<userId>_<rand>       → Premium   ($5/month · $30/year)
 *   premplus_<m|y>_<userId>_<rand>   → Premium+  ($15/month · $90/year)
 *
 * The IPN webhook (/api/webhooks/blockbee) routes by that prefix, resolves
 * the exact row by id, verifies the per-row callbackNonce and — once the
 * on-chain payment confirms — flips status to "confirmed" and extends the
 * user's plan/premiumUntil exactly once (atomic updateMany guard, same
 * pattern as CryptoTopUp). plan/period/days are persisted on the row so the
 * webhook never trusts the prefix string beyond routing.
 *
 * status: "pending" | "confirmed" | "expired".
 */
model PremiumOrder {
  id             String    @id
  userId         String
  /// "premium" | "premium_plus" — what this order activates
  plan           String
  /// "monthly" | "yearly" — billing period sold
  period         String
  /// Days added to premiumUntil on confirmation (30 monthly / 365 yearly)
  days           Int
  /// Exact price charged in US cents (500/3000 · 1500/9000)
  amountExpected Int
  /// Confirmed received USD value in cents (0 until confirmed)
  amountReceived Int       @default(0)
  status         String    @default("pending")
  /// "blockbee" — which processor issued the payment address
  provider       String    @default("blockbee")
  /// BlockBee coin ticker for this intention (e.g. polygon_usdt)
  coin           String?
  /// Unguessable per-intention nonce embedded in the callback URL and
  /// verified on every IPN (binds a webhook to exactly this order)
  callbackNonce  String?
  /// BlockBee payment UUID — the cross-retry dedupe key echoed by every IPN
  uuid           String?   @unique
  /// On-chain transaction hash of the incoming payment (txid_in)
  txHash         String?
  /// Crypto amount paid, as received (string — never trust floats with money)
  paidCoinAmount String?
  /// Coin USD price at payment time (BlockBee `price` field), string
  coinPriceUsd   String?
  walletAddress  String
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([provider, status])
}

/**
 * Append-only audit trail for every payment event: BlockBee IPNs (accepted
 * AND rejected), payout webhook transitions, admin/simulate confirms,
 * referral commissions and withdrawal requests. `externalId` carries the
 * BlockBee payment uuid / payout id / on-chain tx hash so an operator can
 * cross-reference any ledger movement with the processor's console.
 */
model PaymentLog {
  id          String   @id @default(cuid())
  /// "blockbee_ipn" | "blockbee_payout" | "admin_confirm" |
  /// "simulate_confirm" | "referral_withdraw" | "referral_commission"
  source      String
  /// What happened: "received" | "rejected" | "credited" | "pending" |
  /// "done" | "failed" | "commission_credited" | …
  event       String
  ok          Boolean  @default(true)
  /// BlockBee payment uuid / payout id / tx hash
  externalId  String?
  /// CryptoTopUp.id or ReferralWithdrawal.id this event belongs to
  referenceId String?
  userId      String?
  amountCents Int?
  /// Sanitised payload snapshot (no secrets, truncated)
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([source, createdAt])
  @@index([referenceId])
  @@index([externalId])
}

/**
 * One referral-commission withdrawal. The user requests a payout of part of
 * their referralBalance; the funds are sent through the BlockBee payout
 * chain (request → create → process) to the user's own crypto address.
 *
 * IMPORTANT: referralBalance is deducted only when BlockBee confirms the
 * payout (status "done" via the payout webhook) — a failed/expired payout
 * never takes the user's balance. While a withdrawal is pending/processing
 * the user cannot start a second one (single-active-withdrawal guard).
 *
 * status: "pending" (row created, BlockBee chain not yet complete) |
 * "processing" (broadcast accepted, awaiting on-chain settlement) |
 * "done" (confirmed on-chain — balance deducted) | "failed" (chain/API
 * error, nothing was sent) | "expired" (settlement dropped, nothing was
 * sent) | "underfunded" (payout settled but the balance changed underneath
 * — operator must resolve manually; should never happen).
 */
model ReferralWithdrawal {
  id              String    @id @default(cuid())
  userId          String
  /// Requested amount in US cents (what is deducted from referralBalance)
  amountCents     Int
  /// BlockBee ticker the payout is sent in (e.g. polygon_usdt)
  coin            String
  /// Destination address provided by the user
  address         String
  /// Crypto amount sent (converted from USD at request time, string)
  coinAmount      String?
  /// BlockBee payout REQUEST id (payout/request/create)
  payoutRequestId String?
  /// BlockBee payout id (payout/create) — the processable id echoed by the
  /// payout webhook
  payoutId        String?   @unique
  status          String    @default("pending")
  error           String?
  txHash          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}
